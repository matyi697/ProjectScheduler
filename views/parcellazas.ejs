<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="navbar">
        <div style="display: flex; align-items: center;">
            <img src="https://fejlesztes.pipettacenter.hu/wp-content/uploads/2025/06/PIPETTA-CENTER-LOGO-7.png"
                alt="Logo" class="nav-logo">
            <h1>Munka Felvétel</h1>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="nav-link">⬅ Dashboard</a>
            <a href="/logout" class="logout-btn">Kijelentkezés</a>
        </div>
    </div>

    <div class="container-dashboard" id="munka-nezet">
        <div id="successMessage" class="alert-success">
            ✅ A munka sikeresen mentve!
          </div>
        <div id="failMessage" class="alert-fail">
            ❌ A művelet sikertelen!
          </div>

        <div class="form-group">
            <label>Válasszon főcsomagot a parcellázáshoz:</label>
            <select class="form-control" id="focsomag-select">
                <option value="">Válasszon csomagot...</option>
                <% csomagok.forEach(function(csomag) { %>
                    <option value="<%= csomag.id %>" data-notes="<%= csomag.notes || '' %>"
                        data-arrival="<%= csomag.formatted_arrival %>" data-due="<%= csomag.formatted_due %>"
                        data-sc="<%= csomag.shipping_country || '' %>" data-sz="<%= csomag.shipping_zip || '' %>"
                        data-sci="<%= csomag.shipping_city || '' %>" data-ss="<%= csomag.shipping_street || '' %>"
                        data-bc="<%= csomag.billing_country || '' %>" data-bz="<%= csomag.billing_zip || '' %>"
                        data-bci="<%= csomag.billing_city || '' %>" data-bs="<%= csomag.billing_street || '' %>">
                        📦 <%= csomag.job_year %>/<%= csomag.job_number %> — <%= csomag.company_name %>
                    </option>
                    <% }); %>
            </select>
        </div>

        <div class="grid-2col">
            <div>
                <div class="fieldset-box">
                    <div class="fieldset-title-parcell">📍 Kiszállítási cím</div>
                    <input type="text" class="form-control" id="ship_country" placeholder="Ország"
                        style="margin-bottom:8px;">
                    <div style="display:flex; gap:8px; margin-bottom:8px;">
                        <input type="text" class="form-control" id="ship_zip" placeholder="Ir. sz." style="width: 30%;">
                        <input type="text" class="form-control" id="ship_city" placeholder="Település">
                    </div>
                    <input type="text" class="form-control" id="ship_street" placeholder="Utca, házszám">
                </div>

                <div class="fieldset-box">
                    <div class="fieldset-title-parcell">⚙️ Adatok</div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label>Árajánlat:</label>
                            <select class="form-control" id="arajanlat">
                                <option value="nem kell">Nem kell</option>
                                <option value="kell">Kell</option>
                                <option value="szerviz stop">Szerviz stop</option>
                                <option value="kalibralas stop">Kalibrálás stop</option>
                                <option value="szamla stop">Számla stop</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Mérés:</label>
                            <select class="form-control" id="meres">
                                <option>Akkreditált bizonyítvány</option>
                                <option>Mérési jegyzőkönyv</option>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group"><label>Átvétel dátuma:</label><input type="date" class="form-control"
                                id="arrival_date"></div>
                        <div class="form-group"><label>Határidő:</label><input type="date" class="form-control"
                                id="due_date"></div>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Egyedi megjegyzés (csak ehhez a parcellához):</label>
                        <textarea class="form-control" id="notes" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <div>
                <div class="fieldset-box">
                    <div class="fieldset-title-parcell">💳 Számlázási cím</div>
                    <input type="text" class="form-control" id="bill_country" placeholder="Ország"
                        style="margin-bottom:8px;">
                    <div style="display:flex; gap:8px; margin-bottom:8px;">
                        <input type="text" class="form-control" id="bill_zip" placeholder="Ir. sz." style="width: 30%;">
                        <input type="text" class="form-control" id="bill_city" placeholder="Település">
                    </div>
                    <input type="text" class="form-control" id="bill_street" placeholder="Utca, házszám"
                        style="margin-bottom:8px;">
                    <div style="text-align: right;"><button class="btn" onclick="copyAddress()">⬇ Másolás
                            szállításiból</button></div>
                </div>

                <div class="fieldset-box">
                    <div class="fieldset-title-parcell">🧪 Felvett Pipetták</div>
                    <div class="pipetta-list-parcell" id="pipetta-lista-tarolo">
                        <div style="color: #888; text-align: center; margin-top: 70px; font-style: italic;">Nincs még
                            pipetta felvéve</div>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <button class="btn btn-danger" onclick="listaUritese()">Lista ürítése</button>
                        <button class="btn btn-primary" onclick="toggleNezet('pipetta')">➕ Új pipetta
                            hozzáadása</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-buttons-parcell">
            <button class="btn" onclick="window.location.href='/dashboard'">Mégsem</button>
            <button class="btn btn-primary" style="padding: 12px 30px;" onclick="munkaMenteseASzerverre()">💾 Munka
                Mentése</button>
        </div>

    </div>

    <div class="container-dashboard hidden" id="pipetta-nezet">
        <h2 id="pipetta-cim">➕ Új pipetta hozzáadása</h2>

        <div class="grid-2col">
            <div>
                <div class="fieldset-box">
                    <div class="fieldset-title-parcell">Azonosítás és Pontok</div>
                    <div class="form-group">
                        <label>Matrica szám:</label>
                        <input type="text" class="form-control" id="matrica_szam" placeholder="Például: PC12345"
                            style="border-color: var(--accent); border-width: 2px;">
                    </div>
                    <div class="form-group">
                        <label>Kalibrációs pontok száma (1-10):</label>
                        <input type="number" id="kalibracios_pontok" class="form-control" value="1" min="1" max="10"
                            style="width: 80px;" oninput="generalSorokat()">
                    </div>

                    <div
                        style="display: flex; gap: 10px; margin: 15px 0 5px 0; font-weight: bold; font-size: 11px; color: var(--gray); text-transform: uppercase;">
                        <div style="width: 80px; text-align: center;">µL</div>
                        <div style="width: 80px; text-align: center;">± Inacc %</div>
                        <div style="width: 80px; text-align: center;">± Imprec %</div>
                    </div>

                    <div id="dinamikus-mezok-tarolo">
                        <div class="calib-row">
                            <input type="number" step="0.01" class="form-control" placeholder="µL">
                            <input type="number" step="0.01" class="form-control" placeholder="%">
                            <input type="number" step="0.01" class="form-control" placeholder="%">
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 10px;">
                    <button class="btn" onclick="megsemPipettaBase()" style="flex: 1;">Mégsem</button>
                    <button class="btn btn-primary" id="btn-pipetta-mentes" style="flex: 2;"
                        onclick="pipettaMenteseListaba()">✔ Mentés a listába</button>
                </div>
            </div>

            <div>
                <div class="fieldset-box" style="background: #fdfdfd;">
                    <div class="fieldset-title-parcell">Részletek (Törzsadat)</div>

                    <datalist id="gyarto-lista">
                        <% gyartok.forEach(function(g) { %>
                            <option value="<%= g %>"></option>
                            <% }); %>
                    </datalist>
                    <datalist id="tipus-lista">
                        <% tipusok.forEach(function(t) { %>
                            <option value="<%= t %>"></option>
                            <% }); %>
                    </datalist>
                    <datalist id="fajta-lista">
                        <option value="Egy csatornás"></option>
                        <option value="Négy csatornás"></option>
                        <option value="Nyolc csatornás"></option>
                        <option value="Tizenkét csatornás"></option>
                        <option value="Egy csatornás elektromos"></option>
                        <option value="Négy csatornás elektromos"></option>
                        <option value="Nyolc csatornás elektromos"></option>
                        <option value="Tizenkét csatornás elektromos"></option>
                        <option value="Fecskendő"></option>
                        <option value="Pipettor"></option>
                        <option value="Diszpenzer"></option>
                        <option value="Büretta"></option>
                        <option value="Egyéb"></option>
                    </datalist>

                    <div class="form-group">
                        <label>Márka (Gyártó):</label>
                        <input type="text" class="form-control" id="torzs_gyarto" list="gyarto-lista"
                            placeholder="Gépeljen vagy válasszon...">
                    </div>
                    <div class="form-group">
                        <label>Modell:</label>
                        <input type="text" class="form-control" id="torzs_tipus" list="tipus-lista"
                            placeholder="Gépeljen vagy válasszon...">
                    </div>
                    <div class="form-group">
                        <label>Gyári szám:</label>
                        <input type="text" class="form-control" id="torzs_gyari_szam" placeholder="S/N">
                    </div>
                    <div class="form-group">
                        <label>Fajta:</label>
                        <input type="text" class="form-control" id="torzs_fajta" list="fajta-lista"
                            placeholder="Gépeljen vagy válasszon...">
                    </div>
                    <div class="form-group">
                        <label>Térfogat:</label>
                        <input type="text" class="form-control" id="torzs_terfogat" placeholder="pl. 10-100 µl">
                    </div>

                    <div
                        style="font-size: 11px; color: #888; line-height: 1.4; border-top: 1px solid #eee; padding-top: 10px; margin-top: 10px;">
                        ℹ️ Ha a matrica szám alapján létezik a pipetta a rendszerben, ezek a mezők automatikusan
                        kitöltődnek.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let felvettPipettak = [];
        let szerkesztesAlattAllIndex = null;

        // 1. NÉZETEK VÁLTÁSA ÉS GOMB FELIRAT
        function toggleNezet(nezet) {
            if (nezet === 'pipetta') {
                document.getElementById('munka-nezet').classList.add('hidden');
                document.getElementById('pipetta-nezet').classList.remove('hidden');

                const gomb = document.getElementById('btn-pipetta-mentes');
                const cim = document.getElementById('pipetta-cim');

                if (szerkesztesAlattAllIndex !== null) {
                    gomb.innerText = "✔ Módosítás mentése";
                    cim.innerText = "✏️ Pipetta szerkesztése";
                } else {
                    gomb.innerText = "✔ Mentés a listába";
                    cim.innerText = "➕ Új pipetta hozzáadása";
                }

                setTimeout(() => document.getElementById('matrica_szam').focus(), 100);
            } else {
                document.getElementById('pipetta-nezet').classList.add('hidden');
                document.getElementById('munka-nezet').classList.remove('hidden');
            }
        }

        // 2. DINAMIKUS MEZŐK GENERÁLÁSA
        function generalSorokat() {
            if (szerkesztesAlattAllIndex !== null) return; // Szerkesztésnél ne törölje ki, ha véletlen belekattint
            let darab = parseInt(document.getElementById('kalibracios_pontok').value) || 1;
            const tarolo = document.getElementById('dinamikus-mezok-tarolo');
            tarolo.innerHTML = '';
            for (let i = 0; i < darab; i++) {
                tarolo.innerHTML += `
                <div class="calib-row">
                    <input type="number" step="0.01" class="form-control" placeholder="µL">
                    <input type="number" step="0.01" class="form-control" placeholder="%">
                    <input type="number" step="0.01" class="form-control" placeholder="%">
                </div>`;
            }
        }

        // 3. MATRICA AUTOFILL
        document.getElementById('matrica_szam').addEventListener('blur', async function () {
            const matrica = this.value.trim();
            if (!matrica || szerkesztesAlattAllIndex !== null) return; // Szerkesztésnél ne keressen rá újra
            try {
                const res = await fetch('/api/pipetta/' + matrica);
                const data = await res.json();
                if (data.letezik) {
                    document.getElementById('torzs_gyarto').value = data.adat.gyarto || '';
                    document.getElementById('torzs_tipus').value = data.adat.tipus || '';
                    document.getElementById('torzs_fajta').value = data.adat.fajta || '';
                    document.getElementById('torzs_terfogat').value = data.adat.terfogat || '';
                    document.getElementById('torzs_gyari_szam').value = data.adat.gyari_szam || '';
                }
            } catch (e) { console.error("Keresési hiba:", e); }
        });

        // 4. CSOMAG ADATOK VISSZATÖLTÉSE
        document.getElementById('focsomag-select').addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (!opt.value) {
                document.getElementById('arrival_date').value = ''; document.getElementById('due_date').value = '';
                document.getElementById('ship_country').value = ''; document.getElementById('ship_zip').value = '';
                document.getElementById('ship_city').value = ''; document.getElementById('ship_street').value = '';
                document.getElementById('bill_country').value = ''; document.getElementById('bill_zip').value = '';
                document.getElementById('bill_city').value = ''; document.getElementById('bill_street').value = '';
                document.getElementById('notes').value = ''; return;
            }
            document.getElementById('arrival_date').value = opt.getAttribute('data-arrival');
            document.getElementById('due_date').value = opt.getAttribute('data-due');
            document.getElementById('ship_country').value = opt.getAttribute('data-sc');
            document.getElementById('ship_zip').value = opt.getAttribute('data-sz');
            document.getElementById('ship_city').value = opt.getAttribute('data-sci');
            document.getElementById('ship_street').value = opt.getAttribute('data-ss');
            document.getElementById('bill_country').value = opt.getAttribute('data-bc');
            document.getElementById('bill_zip').value = opt.getAttribute('data-bz');
            document.getElementById('bill_city').value = opt.getAttribute('data-bci');
            document.getElementById('bill_street').value = opt.getAttribute('data-bs');
            document.getElementById('notes').value = opt.getAttribute('data-notes') || '';
        });

        function copyAddress() {
            document.getElementById('bill_country').value = document.getElementById('ship_country').value;
            document.getElementById('bill_zip').value = document.getElementById('ship_zip').value;
            document.getElementById('bill_city').value = document.getElementById('ship_city').value;
            document.getElementById('bill_street').value = document.getElementById('ship_street').value;
        }

        // 5. SZERKESZTÉS INDÍTÁSA
        function szerkesztPipettat(index) {
            const p = felvettPipettak[index];
            szerkesztesAlattAllIndex = index;

            document.getElementById('matrica_szam').value = p.matrica;
            document.getElementById('kalibracios_pontok').value = p.pontok;
            document.getElementById('torzs_gyarto').value = p.gyarto;
            document.getElementById('torzs_tipus').value = p.tipus;
            document.getElementById('torzs_fajta').value = p.fajta;
            document.getElementById('torzs_terfogat').value = p.terfogat;
            document.getElementById('torzs_gyari_szam').value = p.gyari_szam;

            const tarolo = document.getElementById('dinamikus-mezok-tarolo');
            tarolo.innerHTML = '';
            for (let i = 0; i < p.pontok; i++) {
                tarolo.innerHTML += `
                <div class="calib-row">
                    <input type="number" step="0.01" class="form-control" value="${p.meresek.ul[i] || ''}">
                    <input type="number" step="0.01" class="form-control" value="${p.meresek.inacc[i] || ''}">
                    <input type="number" step="0.01" class="form-control" value="${p.meresek.imprec[i] || ''}">
                </div>`;
            }
            toggleNezet('pipetta');
        }

        // 6. PIPETTA MENTÉSE
        function pipettaMenteseListaba() {
            const matrica = document.getElementById('matrica_szam').value;
            if (!matrica) return alert("Matrica szám kötelező!");

            const pontSzam = document.getElementById('kalibracios_pontok').value;
            const uls = [], inaccs = [], imprecs = [];

            document.querySelectorAll('.calib-row').forEach(row => {
                const ins = row.querySelectorAll('input');
                uls.push(ins[0].value); inaccs.push(ins[1].value); imprecs.push(ins[2].value);
            });

            const frissAdat = {
                matrica: matrica,
                gyarto: document.getElementById('torzs_gyarto').value,
                tipus: document.getElementById('torzs_tipus').value,
                fajta: document.getElementById('torzs_fajta').value,
                terfogat: document.getElementById('torzs_terfogat').value,
                gyari_szam: document.getElementById('torzs_gyari_szam').value,
                pontok: pontSzam,
                meresek: { ul: uls, inacc: inaccs, imprec: imprecs }
            };

            if (szerkesztesAlattAllIndex !== null) {
                felvettPipettak[szerkesztesAlattAllIndex] = frissAdat;
            } else {
                felvettPipettak.push(frissAdat);
            }

            frissitPipettaListat();
            megsemPipettaBase();
        }

        function megsemPipettaBase() {
            document.getElementById('matrica_szam').value = '';
            document.getElementById('kalibracios_pontok').value = 1;
            document.getElementById('torzs_gyarto').value = '';
            document.getElementById('torzs_tipus').value = '';
            document.getElementById('torzs_fajta').value = '';
            document.getElementById('torzs_terfogat').value = '';
            document.getElementById('torzs_gyari_szam').value = '';

            document.getElementById('dinamikus-mezok-tarolo').innerHTML = `
            <div class="calib-row">
                <input type="number" step="0.01" class="form-control" placeholder="µL">
                <input type="number" step="0.01" class="form-control" placeholder="%">
                <input type="number" step="0.01" class="form-control" placeholder="%">
            </div>`;

            szerkesztesAlattAllIndex = null;
            toggleNezet('munka');
        }

        function frissitPipettaListat() {
            const t = document.getElementById('pipetta-lista-tarolo');
            if (felvettPipettak.length === 0) {
                t.innerHTML = '<div style="color: #888; text-align: center; margin-top: 50px; font-style: italic;">Nincs még pipetta felvéve</div>';
                return;
            }

            t.innerHTML = felvettPipettak.map((p, index) => `
            <div class="pipetta-item-parcell">
                <div>
                    <strong>${p.matrica}</strong> 
                    <span style="margin-left: 10px;">${p.gyarto} — ${p.pontok} pont</span>
                </div>
                <div style="display:flex; gap:5px;">
                    <button class="btn" style="padding: 4px 10px; font-size: 11px; background: #e3f2fd; color: #007bff; border-color: #007bff;" onclick="szerkesztPipettat(${index})">Szerkesztés</button>
                    <button class="btn-danger" style="padding: 4px 10px; font-size: 11px; border-radius: 4px; border: none; cursor: pointer;" onclick="pipettaTorlese(${index})">Törlés</button>
                </div>
            </div>`).join('');
        }

        function listaUritese() { if (confirm("Törölni akarod az ÖSSZES felvett pipettát ebből a munkából?")) { felvettPipettak = []; frissitPipettaListat(); } }
        function pipettaTorlese(index) { if (confirm("Biztosan törlöd ezt a pipettát a listából?")) { felvettPipettak.splice(index, 1); frissitPipettaListat(); } }

        // 7. VÉGLEGES MENTÉS A SZERVERRE
        async function munkaMenteseASzerverre() {
            const csomagId = document.getElementById('focsomag-select').value;
            if (!csomagId) return alert("Válassz csomagot!");
            if (felvettPipettak.length === 0) return alert("Adj hozzá legalább egy pipettát!");

            const adatok = {
                munkaAdatok: {
                    csomag_id: csomagId,
                    arajanlat: document.getElementById('arajanlat').value,
                    meres: document.getElementById('meres').value,
                    arrival_date: document.getElementById('arrival_date').value,
                    due_date: document.getElementById('due_date').value,
                    notes: document.getElementById('notes').value
                },
                pipettak: felvettPipettak
            };

            try {
                const res = await fetch('/api/munka-mentes', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(adatok)
                });
                const resp = await res.json();

                if (resp.success) {
                    const visszajelzo = document.getElementById('mentes-visszajelzes');
                    mutasErtesitest('siker');      
                    felvettPipettak = []; frissitPipettaListat();
                    document.getElementById('notes').value = '';
                } else {
                    alert("Hiba a mentés során: " + (resp.error || "Ismeretlen hiba"));
                    mutasErtesitest('hiba');
                }
            } catch (e) { console.error(e); alert("Hálózati hiba történt a mentéskor."); }
        }

        async function csomagLezarasa() {
            const csomagId = document.getElementById('focsomag-select').value;
            if (!csomagId) return alert("Válassz ki egy csomagot, amit le akarsz zárni!");
            if (!confirm("Biztosan lezárod a csomagot?")) return;
            try {
                const res = await fetch(`/api/csomag-lezarasa/${csomagId}`, { method: 'POST' });
                if ((await res.json()).success) { alert("Csomag sikeresen lezárva!"); window.location.href = '/dashboard'; }
                else alert("Hiba történt a lezárás során.");
            } catch (e) { console.error(e); alert("Hálózati hiba!"); }
        }

        function mutasErtesitest(tipus) {
            const successBox = document.getElementById('successMessage');
            const failBox = document.getElementById('failMessage');

            successBox.classList.remove('show-toast');
            failBox.classList.remove('show-toast');

            const aktivDoboz = (tipus === 'siker') ? successBox : failBox;

            setTimeout(() => {
                aktivDoboz.classList.add('show-toast'); 
                
                setTimeout(() => {
                    aktivDoboz.classList.remove('show-toast');
                }, 3500);
            }, 50);
        }

    </script>
</body>

</html>
