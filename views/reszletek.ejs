<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <title>Csomag Adatlap - <%= csomag.azonosito %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <div class="navbar">
        <img src="https://fejlesztes.pipettacenter.hu/wp-content/uploads/2025/06/PIPETTA-CENTER-LOGO-7.png" alt="Logo"
            class="nav-logo">
        <h1>📦 Csomag Információk</h1>
        <div class="nav-right">
            <a href="/dashboard" class="nav-link">⬅ Vissza a Főmenübe</a>
            <a href="/logout" class="logout-btn">Kijelentkezés</a>
        </div>
    </div>
    <div class="container-parcel">

        <div class="header-card">
            <div class="header-info">
                <h1>Csomag: <%= csomag.azonosito %>
                </h1>
                <p style="margin: 5px 0 0; color: var(--gray); font-size: 16px;">
                    Ügyfél: <strong style="color: var(--primary);">
                        <%= csomag.company_name %>
                    </strong>
                </p>
            </div>

            <div style="display: flex; align-items: center; gap: 15px;">
                <% if (csomag.is_closed) { %>
                    <button onclick="csomagFeloldasa(<%= csomag.id %>)" class="btn-action"
                        style="background: var(--success); color: white; padding: 10px 20px; font-size: 14px; border-radius: 6px;">
                        🔓 Csomag Feloldása
                    </button>
                <% } else { %>
                    <button onclick="csomagLezarasa(<%= csomag.id %>)" class="btn-action"
                        style="background: #343a40; color: white; padding: 10px 20px; font-size: 14px; border-radius: 6px;">
                        📦 Csomag Késznek Jelölése
                    </button>
                <% } %>

                        <a href="/csomag-szerkesztes/<%= csomag.id %>" class="btn-action"
                            style="background: #ffc107; color: #000; padding: 10px 20px; font-size: 14px; border-radius: 6px;">
                            ✏️ Csomag szerkesztése
                        </a>

                        <div class="status-badge <%= csomag.is_closed ? 'status-closed' : 'status-open' %>">
                            <%= csomag.is_closed ? 'Kiküldve' : 'Folyamatban' %>
                        </div>
            </div>
        </div>

        <div class="details-grid">
            <div class="info-card">
                <h3>📝 Általános Információk</h3>
                <div class="data-row">
                    <span class="label">Kapcsolattartó</span>
                    <span class="value">
                        <%= csomag.contact_name || '-' %>
                    </span>
                </div>
                <div class="data-row">
                    <span class="label">Beérkezés</span>
                    <span class="value">
                        <%= csomag.erkezes %>
                    </span>
                </div>
                <div class="data-row">
                    <span class="label">Határidő</span>
                    <span class="value" style="color: var(--danger);">
                        <%= csomag.hatarido || 'Nincs megadva' %>
                    </span>
                </div>
                <div class="data-row">
                    <span class="label">Munkák száma</span>
                    <span class="value">
                        <%= csomag.item_count %> db
                    </span>
                </div>

                <h3 style="margin-top:25px;">📍 Címek</h3>
                <div class="address-container">
                    <div class="address-box">
                        <small>Szállítási cím</small>
                        <strong>
                            <%= csomag.shipping_city %>
                        </strong><br>
                        <%= csomag.shipping_zip %>, <%= csomag.shipping_street %>
                    </div>
                    <div class="address-box">
                        <small>Számlázási cím</small>
                        <strong>
                            <%= csomag.billing_city %>
                        </strong><br>
                        <%= csomag.billing_zip %>, <%= csomag.billing_street %>
                    </div>
                </div>
            </div>

            <div class="info-card" style="background: #fffdf5; border: 1px solid #ffeeba;">
                <h3>🚚 Logisztika & Megjegyzés</h3>
                <p class="label">Futár adatai:</p>
                <div
                    style="background: white; padding: 10px; border-radius: 4px; border: 1px solid #eee; font-weight: 600;">
                    <%= csomag.courier_info || 'Nincs adat' %>
                </div>

                <p class="label" style="margin-top: 15px;">Belső megjegyzés:</p>
                <div
                    style="background: white; padding: 10px; border-radius: 4px; border: 1px solid #eee; font-weight: 600;">
                    <%= csomag.notes || 'Nincs megjegyzés' %>
                </div>
            </div>
        </div>

        <div class="jobs-card">
            <h3>🛠 Csomaghoz tartozó munkák</h3>
            <table>
                <thead>
                    <tr>
                        <th>Sorszám</th>
                        <th>Árajánlat</th>
                        <th>Mérés típusa</th>
                        <th>Egyedi Megjegyzés</th>
                        <th>Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(munkak.length===0) { %>
                        <tr>
                            <td colspan="5" style="text-align:center; color:#888;">Még nincs parcellázva ez a csomag.
                            </td>
                        </tr>
                        <% } else { %>
                            <% munkak.forEach(munka=> { %>
                                <tr>
                                    <td><strong>
                                            <%= csomag.azonosito %>/<%= munka.sub_number %>
                                        </strong></td>
                                    <td>
                                        <%= munka.arajanlat %>
                                    </td>
                                    <td>
                                        <%= munka.meres %>
                                    </td>
                                    <td style="font-style: italic; font-size: 13px;">
                                        <%= munka.notes || '-' %>
                                    </td>
                                    <td style="display: flex; gap: 8px;">
                                        <a href="/statusz/<%= munka.id %>" class="btn-action"
                                            style="background: var(--accent); color: white;">Pipetták ➔</a>
                                        <a href="/munka-szerkesztes/<%= munka.id %>" class="btn-action"
                                            style="background: #ffc107; color: #000;">✏️ Szerk.</a>
                                        <button onclick="torolMunkat(<%= munka.id %>)" class="btn btn-danger"
                                            style="border-width: 2px;">🗑️ Törlés</button>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="footer">
            <a href="/dashboard" class="btn btn-back">⬅ Vissza a Dashboardra</a>
            <button onclick="torolCsomagot(<%= csomag.id %>)" class="btn btn-danger"
                style="border-width : 3px;">🗑️ Teljes Csomag Törlése</button>
        </div>
    </div>

    <script>
        async function csomagFeloldasa(id) {
            if (!confirm("Biztosan újra megnyitod ezt a csomagot?\nEzután ismét megjelenik majd a parcellázási listában.")) return;

            try {
                const res = await fetch(`/api/csomag-feloldasa/${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert("Csomag sikeresen újranyitva!");
                    location.reload();
                } else {
                    alert("Hiba történt a feloldás során.");
                }
            } catch (e) {
                console.error(e);
                alert("Hálózati hiba!");
            }
        }

        async function torolMunkat(munkaId) {
            if (!confirm("Biztosan törlöd ezt a parcellát (munkát)?\n\n(A pipetták törzsadatai megmaradnak, csak a mérések törlődnek!)")) return;

            try {
                const res = await fetch(`/api/munka-torlese/${munkaId}`, { method: 'DELETE' });
                if ((await res.json()).success) {
                    window.location.reload();
                } else {
                    alert("Hiba a törlés során!");
                }
            } catch (e) {
                console.error(e);
                alert("Hálózati hiba!");
            }
        }

        async function torolCsomagot(csomagId) {
            if (!confirm("FIGYELEM! Biztosan törlöd a TELJES csomagot az összes munkával együtt?\n\nEz a lépés nem visszavonható!")) return;

            try {
                const res = await fetch(`/api/csomag-torlese/${csomagId}`, { method: 'DELETE' });
                if ((await res.json()).success) {
                    alert("Csomag sikeresen törölve!");
                    window.location.href = '/dashboard';
                } else {
                    alert("Hiba a törlés során!");
                }
            } catch (e) {
                console.error(e);
                alert("Hálózati hiba!");
            }
        }

        async function csomagLezarasa(csomagId) {
            if (!confirm("Biztosan késznek jelölöd és lezárod ezt a csomagot?")) return;

            try {
                const res = await fetch(`/api/csomag-lezarasa/${csomagId}`, { method: 'POST' });
                const data = await res.json();
                
                if (data.success) { 
                    alert("Csomag sikeresen lezárva!"); 
                    window.location.reload(); // Frissítjük az oldalt, így a gomb átvált "Feloldásra", a státusz pedig "Kiküldve"-re
                } else {
                    alert("Hiba történt a lezárás során.");
                }
            } catch (e) { 
                console.error(e); 
                alert("Hálózati hiba történt a lezáráskor!"); 
            }
        }
    </script>
</body>

</html>