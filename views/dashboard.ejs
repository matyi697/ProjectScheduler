<!DOCTYPE html>
<html lang="hu">

<head>
    <meta charset="UTF-8">
    <title>Labor Irányítópult</title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="navbar">
        <h1>
            <img src="https://fejlesztes.pipettacenter.hu/wp-content/uploads/2025/06/PIPETTA-CENTER-LOGO-7.png"
                alt="Logo" class="nav-logo">
        </h1>
        <div class="nav-right">
            <span>👤 Üdv, <strong>
                    <%= username %>
                </strong></span>
            <a href="/logout" class="logout-btn">Kijelentkezés</a>
        </div>
    </div>

    <div class="container-dashboard">

        <div id="successMessage" class="alert-success" style="display:none;">
            ✅ A művelet sikeresen végrehajtva!
        </div>

        <div class="action-bar">
            <div>
                <h2>Vezérlőpult</h2>
            </div>
            <div class="action-buttons">
                <a href="/parcellazas" class="btn btn-warning">📦 Felvétel</a>
                <a href="/uj-munka" class="btn btn-new">➕ Új csomag</a>
            </div>
        </div>

        <form action="/dashboard" method="GET" class="toolbar" id="searchForm" style="display: flex; gap: 15px; align-items: center;">
            <input type="hidden" name="tab" id="formTab" value="<%= typeof activeTab !== 'undefined' ? activeTab : 'munka-tab' %>">
            
            <div class="search-box" style="flex: 1; display: flex; gap: 10px;">
                <input type="text" name="q" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" 
                       placeholder="🔍 Keresés cég, azonosító vagy város alapján..." 
                       style="flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #ccc;">
                <button type="submit" class="btn btn-primary" style="padding: 10px 20px; border-radius: 6px;">Keresés</button>
            </div>
            <div class="filter-box">
                <label style="cursor: pointer; font-weight: bold; color: var(--gray);">
                    <input type="checkbox" name="archived" value="true" 
                           <%= (typeof showArchived !== 'undefined' && showArchived) ? 'checked' : '' %> 
                           onchange="document.getElementById('searchForm').submit();"> 
                    🗄️ Kész/Archivált mutatása
                </label>
            </div>
        </form>
        <div class="tab-container">
            <button class="tab-btn <%= (typeof activeTab === 'undefined' || activeTab === 'munka-tab') ? 'active' : '' %>" onclick="switchTab('munka-tab', this)">🛠 Munkák</button>
            <button class="tab-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'csomag-tab') ? 'active' : '' %>" onclick="switchTab('csomag-tab', this)">📦 Csomagok</button>
            <button class="tab-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'pipetta-tab') ? 'active' : '' %>" onclick="switchTab('pipetta-tab', this)">🧪 Pipetták</button>
        </div>
    
            <div id="munka-tab" class="card <%= (typeof activeTab !== 'undefined' && activeTab !== 'munka-tab') ? 'hidden' : '' %>">
              <table id="munkaTable">
                <thead>
                    <tr>
                        <th onclick="sortTable('munkaTable', 0)">Munka ID</th>
                        <th onclick="sortTable('munkaTable', 1)">Ügyfél</th>
                        <th onclick="sortTable('munkaTable', 2)">Határidő</th>
                        <th onclick="sortTable('munkaTable', 3)">Haladás</th>
                        <th>Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    <% jobs.forEach(function(job) { %>
                        <tr class="<%= job.is_sent ? 'archived-row' : '' %>">
                            <td><strong>
                                    <%= job.azonosito %>
                                </strong></td>
                            <td>
                                <%= job.company_name %>
                            </td>

                            <% let dateColor='var(--success)' ; if (job.hatarido && job.hatarido !=='Nincs' ) { let
                                due=new Date(job.hatarido.replace(/\./g, '-' )); if (!isNaN(due.getTime())) { let
                                diffDays=(due - new Date()) / (1000 * 60 * 60 * 24); if (diffDays <=7)
                                dateColor='var(--danger)' ; } } %>
                                <td style="color: <%= dateColor %>; font-weight: bold;">
                                    <%= job.hatarido || 'Nincs' %>
                                </td>

                                <td>
                                    <% if (job.osszes_pipetta> 0) { %>
                                        <% let szazalek=Math.round((job.kesz_pipetta / job.osszes_pipetta) * 100); let
                                            badgeClass=(szazalek===100) ? 'badge-done' : 'badge-process' ; %>
                                            <span class="badge <%= badgeClass %>">
                                                <%= job.kesz_pipetta %> / <%= job.osszes_pipetta %> kész (<%= szazalek
                                                            %>%)
                                            </span>
                                            <% } else { %>
                                                <span class="badge badge-closed">Nincs pipetta</span>
                                                <% } %>
                                </td>
                                <td>
                                    <a href="/statusz/<%= job.munka_id %>" class="btn-action">Munkalap ➔</a>
                                </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>

        <div id="csomag-tab" class="card <%= (typeof activeTab !== 'undefined' && activeTab === 'csomag-tab') ? '' : 'hidden' %>">
              <table id="csomagTable">
                <thead>
                    <tr>
                        <th onclick="sortTable('csomagTable', 0)">Csomagszám</th>
                        <th onclick="sortTable('csomagTable', 1)">Ügyfél</th>
                        <th onclick="sortTable('csomagTable', 2)">Beérkezés</th>
                        <th onclick="sortTable('csomagTable', 3)">Határidő</th>
                        <th onclick="sortTable('csomagTable', 4)">Munkák</th>
                        <th onclick="sortTable('csomagTable', 5)">Állapot</th>
                        <th>Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    <% packages.forEach(function(pkg) { %>
                        <tr class="<%= pkg.is_closed ? 'archived-row' : '' %>">
                            <td><strong><%= pkg.azonosito %></strong></td>
                            <td><%= pkg.company_name %></td>
                            <td><%= pkg.datum %></td>
                            
                            <% 
                                let dateColor = 'var(--success)';
                                if (pkg.hatarido && pkg.hatarido !== 'Nincs') {
                                    let due = new Date(pkg.hatarido.replace(/\./g, '-')); // Ha a backend magyar formátumot ad (ÉÉÉÉ. HH. NN.)
                                    if (!isNaN(due.getTime())) {
                                        let diffDays = (due - new Date()) / (1000 * 60 * 60 * 24);
                                        if (diffDays <= 7) dateColor = 'var(--danger)';
                                    }
                                }
                            %>
                            <td style="color: <%= dateColor %>; font-weight: bold;"><%= pkg.hatarido || 'Nincs' %></td>
                            
                            <td>
                               <span class="badge <%= pkg.kesz_munkak_szama == pkg.al_munkak_szama && pkg.al_munkak_szama > 0 ? 'badge-done' : 'badge-process' %>">
                                   <%= pkg.kesz_munkak_szama %> / <%= pkg.al_munkak_szama %> kész
                               </span>
                            </td>
                            <td>
                                <span class="badge <%= pkg.is_closed ? 'badge-closed' : 'badge-process' %>">
                                    <%= pkg.is_closed ? 'Kiküldve' : 'Folyamatban' %>
                                </span>
                            </td>
                            <td>
                                <a href="/reszletek/<%= pkg.id %>" class="btn-action btn-details">ℹ️ Adatlap</a>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>

        <div id="pipetta-tab" class="card <%= (typeof activeTab !== 'undefined' && activeTab === 'pipetta-tab') ? '' : 'hidden' %>">
              <table id="pipettaTable">
                <thead>
                    <tr>
                        <th onclick="sortTable('pipettaTable', 0)">Matrica Szám</th>
                        <th onclick="sortTable('pipettaTable', 1)">Gyártó / Típus</th>
                        <th onclick="sortTable('pipettaTable', 2)">Fajta / Térfogat</th>
                        <th>Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof allPipettak !== 'undefined' && allPipettak.length > 0) { %>
                        <% allPipettak.forEach(function(pip) { %>
                            <tr>
                                <td><strong><%= pip.matrica_szam %></strong></td>
                                <td><%= pip.gyarto %> <%= pip.tipus %></td>
                                <td><%= pip.fajta %><%= pip.terfogat %> &#181L</td>
                                <td>
                                    <a href="/pipetta-szerkesztes/<%= encodeURIComponent(pip.matrica_szam) %>"
                                        class="btn-action"
                                        style="background: #e3f2fd; color: #007bff; border: 1px solid #007bff;">✏️
                                        Adatlap & Előzmények</a>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align: center; color: #888;">Nincs még felvett
                                            pipetta a törzsadatbázisban.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

    </div>
    <div style="display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 30px; padding: 20px 0; border-top: 1px solid #eee;">
            
        <% if (typeof currentPage !== 'undefined' && currentPage > 1) { %>
            <a href="/dashboard?page=<%= currentPage - 1 %>&q=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>&archived=<%= (typeof showArchived !== 'undefined' && showArchived) ? 'true' : 'false' %>&tab=<%= typeof activeTab !== 'undefined' ? activeTab : 'munka-tab' %>" 
               class="btn" style="padding: 8px 16px; background: #fff; border: 1px solid #ccc; border-radius: 6px; text-decoration: none; color: #333; font-weight: bold;">
                ⬅ Előző
            </a>
        <% } else { %>
            <span style="padding: 8px 16px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 6px; color: #aaa; font-weight: bold; cursor: not-allowed;">
                ⬅ Előző
            </span>
        <% } %>

        <div style="font-size: 15px; font-weight: bold; color: var(--primary);">
            Oldal: <%= typeof currentPage !== 'undefined' ? currentPage : 1 %> / <%= typeof totalPages !== 'undefined' ? totalPages : 1 %>
        </div>

        <% if (typeof currentPage !== 'undefined' && typeof totalPages !== 'undefined' && currentPage < totalPages) { %>
            <a href="/dashboard?page=<%= currentPage + 1 %>&q=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>&archived=<%= (typeof showArchived !== 'undefined' && showArchived) ? 'true' : 'false' %>&tab=<%= typeof activeTab !== 'undefined' ? activeTab : 'munka-tab' %>" 
               class="btn btn-primary" style="padding: 8px 16px; border-radius: 6px; text-decoration: none; color: white; font-weight: bold;">
                Következő ➔
            </a>
        <% } else { %>
            <span style="padding: 8px 16px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 6px; color: #aaa; font-weight: bold; cursor: not-allowed;">
                Következő ➔
            </span>
        <% } %>

    </div>

<script>
        // Tab váltó
        function switchTab(tabId, btn) {
            document.getElementById('munka-tab').classList.add('hidden');
            document.getElementById('csomag-tab').classList.add('hidden');
            document.getElementById('pipetta-tab').classList.add('hidden');

            document.getElementById(tabId).classList.remove('hidden');

            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Beírjuk a rejtett mezőbe a kiválasztott fület, így keresésnél ezt küldi el a szervernek!
            const formTab = document.getElementById('formTab');
            if(formTab) formTab.value = tabId;
        }

        // Oszlop-rendező
        function sortTable(tableId, n) {
            let table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
            table = document.getElementById(tableId);
            switching = true;
            dir = "asc";
            while (switching) {
                switching = false;
                rows = table.rows;
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];
                    let xContent = x.innerHTML.toLowerCase().replace(/<[^>]*>?/gm, '');
                    let yContent = y.innerHTML.toLowerCase().replace(/<[^>]*>?/gm, '');

                    if (dir == "asc") {
                        if (xContent > yContent) { shouldSwitch = true; break; }
                    } else if (dir == "desc") {
                        if (xContent < yContent) { shouldSwitch = true; break; }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount++;
                } else {
                    if (switchcount == 0 && dir == "asc") {
                        dir = "desc";
                        switching = true;
                    }
                }
            }
        }

        // Siker üzenet
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success')) {
            document.getElementById('successMessage').style.display = 'block';
            setTimeout(() => { document.getElementById('successMessage').style.display = 'none'; }, 3000);
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    </script>
</body>

</html>
