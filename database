-- 1. Régi táblák eltakarítása (ha voltak ilyenek)
DROP TABLE IF EXISTS pipettak CASCADE;
DROP TABLE IF EXISTS munkak CASCADE;
DROP TABLE IF EXISTS csomagok CASCADE;

-- 2. Csomagok tábla (Ez már csak a fő csomagot tárolja)
CREATE TABLE csomagok (
    id SERIAL PRIMARY KEY,
    csomag_szam VARCHAR(50) UNIQUE NOT NULL, -- pl. 2025/1
    beeres_ideje DATE DEFAULT CURRENT_DATE
);

-- 3. Munkák tábla (A Parcellázáskor jönnek létre)
CREATE TABLE munkak (
    id SERIAL PRIMARY KEY,
    csomag_id INTEGER REFERENCES csomagok(id) ON DELETE CASCADE, -- Ha a csomag törlődik, ez is!
    munka_szam VARCHAR(50) UNIQUE NOT NULL, -- pl. 2025/1/1
    statusz VARCHAR(50) DEFAULT 'Feldolgozásra vár',
    letrehozva TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4. Pipetták tábla (Ezeket rendeljük a munkákhoz)
CREATE TABLE pipettak (
    id SERIAL PRIMARY KEY,
    munka_id INTEGER REFERENCES munkak(id) ON DELETE CASCADE, -- Ha a munka törlődik, ez is!
    gyari_szam VARCHAR(100),  -- pl. XYZ-12345
    tipus VARCHAR(100),       -- pl. Eppendorf
    terfogat VARCHAR(50),     -- pl. 10-100 ul
    letrehozva TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);